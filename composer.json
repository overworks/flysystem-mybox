{
    "name": "minhyung/flysystem-mybox",
    "description": "Flysystem adapter for Naver MYBOX, built on the minhyung/mybox SDK.",
    "type": "library",
    "keywords": ["flysystem", "filesystem", "mybox", "naver", "adapter", "storage", "laravel"],
    "license": "MIT",
    "homepage": "https://github.com/overworks/flysystem-mybox",
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "urlinee@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "league/flysystem": "^3.29",
        "league/mime-type-detection": "^1.0",
        "minhyung/mybox": "^0.1.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.51",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "league/flysystem-adapter-test-utilities": "^3.29",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-intl": "Folds Hangul file names to NFC so names created on macOS match what MYBOX stores"
    },
    "autoload": {
        "psr-4": {
            "Minhyung\\Flysystem\\Mybox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Minhyung\\Flysystem\\Mybox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --exclude-group integration",
        "test:integration": "phpunit --group integration",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
